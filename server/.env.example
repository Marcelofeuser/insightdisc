NODE_ENV=development
SERVER_PORT=4000
SERVER_URL=http://localhost:4000
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
# Runtime Prisma no Railway: use a pooled/proxy URL aqui.
# Em producao, o backend aplica defaults seguros se connection_limit/pool_timeout nao vierem preenchidos.
DATABASE_URL=postgresql://user:password@proxy.rlwy.net:12345/railway?sslmode=require&connection_limit=5&pool_timeout=20
# Migrations e prisma migrate deploy: use conexao direta, sem pool/proxy.
DIRECT_URL=postgresql://user:password@containers-us-west-123.railway.app:5432/railway?sslmode=require
JWT_SECRET=change-me
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PERSONAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_REPORT_UNLOCK=
STRIPE_PRICE_GIFT=
STRIPE_PRICE_PACK_10=
STRIPE_PRICE_PACK_50=
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_CREDIT_1=
STRIPE_PRICE_CREDIT_5=
STRIPE_PRICE_CREDIT_10=
STRIPE_PRICE_CREDIT_50=
STRIPE_PRICE_ID_CREDITS=
STRIPE_PRICE_ORDER_BUMP_ADVANCED_ANALYSIS=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ALLOW_DEV_EMAIL_AUTH=true

# ================================
# AI (V2.1)
# ================================
# AI_API_URL: endpoint principal para chamadas de IA via HTTP.
# Quando configurado, o backend prioriza este provider e mantém Gemini/Groq apenas como fallback opcional.
AI_API_URL=
AI_PROVIDER=openai
AI_FALLBACK_1=gemini
AI_FALLBACK_2=deterministic_engine
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
